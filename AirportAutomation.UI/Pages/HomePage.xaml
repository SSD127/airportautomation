<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AirportAutomation.UI.Pages.HomePage"
             Title="Home">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">
            <Label Text="Havalimanı Terminal Otomasyonu"
                   FontSize="24"
                   FontAttributes="Bold" />
            <Label Text="Uçuş, kapı, check-in ve yönetim sekmelerine bu ekrandan hızlıca geçebilirsiniz."
                   FontSize="14"
                   TextColor="#4B5563" />

            <VerticalStackLayout Spacing="12">
                <Button Text="Uçuşlar" Clicked="OnFlightsClicked" />
                <Button Text="Kapılar" Clicked="OnGatesClicked" />
                <Button Text="Check-In (Yolcu)" Clicked="OnPassengersClicked" />
                <Button Text="Harita" Clicked="OnMapClicked" />
            </VerticalStackLayout>

            <Frame Padding="14" BackgroundColor="#EEF2FF" CornerRadius="10">
                <VerticalStackLayout Spacing="6">
                    <Label Text="AI Asistan" FontAttributes="Bold" />
                    <Label Text="Sorularınız için AI sekmesine geçebilirsiniz." FontSize="12" TextColor="#4B5563" />
                    <Button Text="AI'ye Git" Clicked="OnAssistantClicked" />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

